proj: tour
parent: diyski
desc: Trip Planner - Next.js service with Calendar Service integration, ready for Zeabur deployment
v: 1.0.0
ts: 2025-12-13T23:58:00Z
status: 🔄 Ready for Zeabur Deployment
tech:
  lang: TypeScript
  fw: Next.js 15 App Router
  db: PostgreSQL (Prisma ORM)
  ui: Tailwind CSS
  auth: User Core (Bearer Token)
  calendar: Integrated with User Core Calendar Service
entry: app/layout.tsx
deploy_config: zeabur.json (needs creation)
r[7]{route,handler,calendar_sync,desc}:
  GET /api/trips,TripRoutes.list,,Trip list with calendar events
  POST /api/trips,TripRoutes.create,✅ CalendarService.onTripCreated,Create trip + calendar event
  GET /api/trips/[id],TripRoutes.get,✅ getTripEvents,Trip detail + events
  PUT /api/trips/[id],TripRoutes.update,✅ CalendarService.onTripUpdated,Update trip + sync calendar
  DELETE /api/trips/[id],TripRoutes.delete,✅ CalendarService.onTripDeleted,Delete trip + cleanup events
  GET /api/days/[id],DayRoutes.get,,Day details
  POST /api/items,ItemRoutes.create,,Create day items
m.page[3]{name,path,calendar_integration,desc}:
  Trips,app/trips/page.tsx,✅ Calendar events display,Trip list + create
  TripDetail,app/trips/[id]/page.tsx,✅ Calendar events,Trip editor + calendar
  Create,app/trips/create/page.tsx,✅ Auto calendar event,Quick create
m.svc[4]{name,path,calendar_status,desc}:
  TourService,lib/services/tour.ts,,Trip CRUD operations
  CalendarService,lib/services/calendar.ts,✅ Complete integration,Calendar sync with User Core
  ResortService,lib/services/resort.ts,,Resort validation
  PreferenceSync,lib/services/preference.ts,,User preference sync
calendar_methods[4]{method,status,desc}:
  onTripCreated,✅ Implemented,Create calendar event when trip created
  onTripUpdated,✅ Implemented,Update calendar event when trip updated
  onTripDeleted,✅ Implemented,Delete calendar events when trip deleted
  getTripEvents,📋 TODO,Get calendar events for specific trip
env_vars[4]{name,desc}:
  DATABASE_URL,PostgreSQL connection for Prisma
  USER_CORE_API_URL,User Core API endpoint
  RESORT_API_BASE_URL,Resort Services API endpoint
  SNOWBUDDY_API_URL,Snowbuddy Matching API endpoint
tbl[5]{name,desc}:
  trips,Trip bookings with user/resort/dates
  days,Daily schedules within trip
  items,Activities/tasks within day
  checklists,Pre-trip preparation items
  packings,Packing item tracking
deployment_needs[3]{task,priority}:
  Create zeabur.json config,⭐⭐⭐
  Setup PostgreSQL database,⭐⭐⭐
  Configure environment variables,⭐⭐⭐
deps[3]: User Core (auth+calendar),Resort Services (validation),Snowbuddy (recommendations)
