proj: snowbuddy-matching
parent: diyski
desc: Smart Buddy Matching - 5D algorithm with calendar integration, deployed on Zeabur
v: 1.1.0
ts: 2025-12-13T23:58:00Z
status: ✅ Deployed + Calendar Integration
tech:
  lang: Python
  fw: FastAPI
  algo: Weighted scoring (30%/25%/20%/15%/10%)
  http: httpx (async)
  deploy: Zeabur (zeabur.json added)
  calendar: EventType.MATCHING integration
entry: app/main.py
deploy_url: https://snowbuddy-matching.zeabur.app
r[4]{route,handler,calendar_sync,desc}:
  POST /searches,SearchRouter.search,✅ Meeting events,Multi-dim matching
  GET /searches/:id,SearchRouter.result,,Get match results
  POST /requests,RequestRouter.create,✅ Calendar events,Send match request
  PUT /requests/:id,RequestRouter.respond,✅ Meeting scheduler,Accept/reject + schedule
calendar_integration[2]{feature,status}:
  Meeting Events,✅ EventType.MATCHING auto-created
  Appointment Scheduling,✅ Calendar Service integration
m.router[2]{name,path,desc,deps}:
  SearchRouter,app/routers/search_router.py,Search logic,MatchingSvc
  RequestRouter,app/routers/requests_router.py,Request management,MatchingSvc
m.core[1]{name,path,desc}:
  MatchingLogic,app/core/matching_logic.py,5D algorithm implementation,
m.svc[4]{name,path,desc,deps}:
  MatchingService,app/services/matching_service.py,Core matching logic,MatchLogic
  NotificationService,app/services/matching_notifications.py,Match notifications,
  TripIntegrationService,app/services/trip_integration.py,Calendar sync,TourAPI|UserCore
  BehaviorEventService,app/services/behavior_event_service.py,Event tracking,UserCore
algo_weights{skill,location,avail,role,knowledge}:
  score: 0.30,0.25,0.20,0.15,0.10
zeabur_config: zeabur.json (PORT env var support)
cfg[2]: requirements.txt,zeabur.json
build_cmd: docker build -t snowbuddy .
deploy_status: ✅ Running on Zeabur
integrate[3]{svc,feature,calendar}:
  User Core,Profile + Auth,✅ Calendar events
  Resort Services,Location matching,
  Ski Platform,Meeting scheduler UI,✅ MeetingScheduler component
